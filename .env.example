# Postgres connection string (Neon, Vercel Postgres or Supabase all work)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Jira (Atlassian Cloud). Create the token at https://id.atlassian.com/manage-profile/security/api-tokens
# using an account that can browse every project you want counted.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Google sign-in. Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://YOUR-SITE.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=https://YOUR-SITE.vercel.app

# Who may open the site (comma separated emails). Everyone else is refused.
ADMIN_EMAILS=admin@example.com
MANAGER_EMAILS=manager@example.com
ALLOWED_DOMAIN=example.com

# Lets the daily Vercel cron call /api/sync. Any long random string.
CRON_SECRET=change-me-too

APP_TIMEZONE=UTC

# Local testing only: skip login
# AUTH_DISABLED=1
